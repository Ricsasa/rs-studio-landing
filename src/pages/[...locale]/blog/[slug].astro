---
import { getCollection, render } from "astro:content";
import { buildStaticPaths } from "astro-react-i18next/utils";
import BlogPostLayout from "@/layouts/BlogPostLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Contact from "@/components/Contact.astro";
import BlogHeader from "@/components/blog/BlogHeader.astro";
import Callout from "@/components/blog/Callout.astro";
import Figure from "@/components/blog/Figure.astro";
import { postSlug } from "@/content.config";

export async function getStaticPaths() {
  const posts = await getCollection("blog", (p) => !p.data.draft);

  const DEFAULT_LOCALE = "es-MX";

  return buildStaticPaths().flatMap(({ params }) => {
    const locale = params.locale ?? DEFAULT_LOCALE;

    return posts
      .filter((post) => post.data.lang === locale)
      .map((post) => ({ params: { ...params, slug: postSlug(post.id) }, props: { post } }));
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogPostLayout post={post}>
  <SiteHeader />
  <main id="main">
    <BlogHeader post={post} />
    <article class="bg-paper px-gutter pb-hero-bottom">
      <div class="prose-blog mx-auto w-full max-w-prose">
        <Content components={{ blockquote: Callout, Figure, Callout }} />
      </div>
    </article>
  </main>
  <Contact />
</BlogPostLayout>
