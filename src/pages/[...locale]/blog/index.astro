---
import i18n from "i18next";
import { getCollection } from "astro:content";
import { buildStaticPaths } from "astro-react-i18next/utils";
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Contact from "@/components/Contact.astro";
import BackToHome from "@/components/BackToHome.astro";
import SectionHead from "@/components/SectionHead.astro";
import { blogPath, blogPostPath } from "@/i18n/routing";
import { postSlug } from "@/content.config";

export function getStaticPaths() {
  return buildStaticPaths();
}

const allPosts = await getCollection("blog", (p) => !p.data.draft);
const posts = allPosts
  .filter((post) => post.data.lang === i18n.language)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const blogIndexHref = blogPath();
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
  a.localeCompare(b),
);
---

<Layout title={i18n.t("blog.title")} description={i18n.t("blog.description")}>
  <SiteHeader />
  <main id="main">
    <section data-reveal class="relative isolate bg-paper px-gutter pt-10 pb-hero-bottom">
      <div class="relative mx-auto w-full max-w-content">
        <SectionHead title={i18n.t("blog.title")} meta={i18n.t("blog.head")} />

        {
          allTags.length > 0 && (
            <div
              data-tag-filter
              data-tag-filter-base={blogIndexHref}
              class="mt-heading flex flex-wrap gap-1.5"
            >
              <a href={blogIndexHref} data-tag="" data-tag-filter-option aria-current="true" class="tag">
                {i18n.t("blog.filter-all-label")}
              </a>
              {allTags.map((tag) => (
                <a
                  href={`${blogIndexHref}?tag=${encodeURIComponent(tag)}`}
                  data-tag={tag}
                  data-tag-filter-option
                  aria-current="false"
                  class="tag"
                >
                  {tag}
                </a>
              ))}
            </div>
          )
        }

        <p data-tag-filter-empty hidden class="mt-heading text-lead-sm text-mute">
          {i18n.t("blog.filter-empty-label")}
        </p>
        <div class="mt-heading grid grid-cols-1 gap-x-grid gap-y-flow md:grid-cols-2 wide:grid-cols-3">
          {
            posts.map((post) => (
              <div
                data-tag-filter-item
                data-tags={post.data.tags.join("|")}
                class="group relative flex flex-col"
              >
                {post.data.cover ? (
                  <div class="relative overflow-hidden bg-substrate">
                    <img
                      src={post.data.cover.src}
                      alt={post.data.coverAlt ?? ""}
                      loading="lazy"
                      decoding="async"
                      class="block aspect-16/10 w-full object-cover object-top transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.02]"
                    />
                    <span aria-hidden="true" class="halftone-fine absolute inset-0 opacity-8" />
                  </div>
                ) : (
                  <div class="flex aspect-16/10 items-center justify-center bg-substrate">
                    <span class="label text-mute">{post.data.title}</span>
                  </div>
                )}

                <span class="label mt-5 text-mute">
                  {new Intl.DateTimeFormat(i18n.language, { year: "numeric", month: "long", day: "numeric" }).format(
                    post.data.pubDate,
                  )}
                </span>
                <h3 class="mt-2 text-subhead display-face">
                  <a href={blogPostPath(postSlug(post.id))} class="static after:absolute after:inset-0">
                    <span class="rule-wipe group-hover:rule-wipe-on">{post.data.title}</span>
                  </a>
                </h3>
                <p class="mt-2.5 text-lead-sm text-pretty text-graphite">{post.data.description}</p>

                {post.data.tags.length > 0 && (
                  <div class="relative z-10 mt-3 flex flex-wrap gap-1.5">
                    {post.data.tags.map((tag) => (
                      <a
                        href={`${blogIndexHref}?tag=${encodeURIComponent(tag)}`}
                        class="tag relative z-10"
                      >
                        {tag}
                      </a>
                    ))}
                  </div>
                )}

                <span class="mt-auto flex items-center gap-2 pt-5 text-lead-sm font-medium">
                  {i18n.t("blog.readMore")}
                  <span
                    aria-hidden="true"
                    class="text-moss transition-transform duration-200 group-hover:translate-x-1"
                  >
                    &#8594;
                  </span>
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <BackToHome />
  <Contact />
</Layout>
<script>
  function initTagFilter() {
    const container = document.querySelector<HTMLElement>("[data-tag-filter]");
    if (!container) return;

    const base = container.dataset.tagFilterBase ?? "";
    const chips = Array.from(container.querySelectorAll<HTMLAnchorElement>("[data-tag-filter-option]"));
    const items = Array.from(document.querySelectorAll<HTMLElement>("[data-tag-filter-item]"));
    const empty = document.querySelector<HTMLElement>("[data-tag-filter-empty]");

    function applyTag(tag: string) {
      let visibleCount = 0;

      for (const item of items) {
        const tags = (item.dataset.tags ?? "").split("|").filter(Boolean);
        const visible = tag === "" || tags.includes(tag);
        item.hidden = !visible;
        if (visible) visibleCount += 1;
      }

      for (const chip of chips) {
        chip.setAttribute("aria-current", String((chip.dataset.tag ?? "") === tag));
      }

      if (empty) empty.hidden = visibleCount > 0;
    }

    for (const chip of chips) {
      chip.addEventListener("click", (event) => {
        event.preventDefault();
        const tag = chip.dataset.tag ?? "";

        const url = new URL(base, window.location.origin);
        if (tag) url.searchParams.set("tag", tag);
        history.replaceState(null, "", `${url.pathname}${url.search}`);

        applyTag(tag);
      });
    }

    const initialTag = new URLSearchParams(window.location.search).get("tag") ?? "";
    applyTag(initialTag);
  }

  initTagFilter();
</script>
