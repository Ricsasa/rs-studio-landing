---
import Layout from "@/layouts/Layout.astro";
import Intro from "@/components/Intro.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Hero from "@/components/Hero.astro";
import HeroMission from "@/components/HeroMission.astro";
import Work from "@/components/Work.astro";
import Services from "@/components/Services.astro";
import BrandManifesto from "@/components/BrandManifesto.astro";
import Process from "@/components/Process.astro";
import Stack from "@/components/Stack.astro";
import Contact from "@/components/Contact.astro";
import { buildStaticPaths } from "astro-react-i18next/utils";

export function getStaticPaths() {
  return buildStaticPaths();
}
---

<Layout>
  {/* Landing page only — the case-study pages are arrived at from here, so replaying it would just be in the way. */}
  <Intro />
  <SiteHeader />
  <main id="main">
    <Hero />
    <HeroMission />
    <BrandManifesto />
    <Work />
    <Services />
    <Process />
    <Stack />
  </main>
  <Contact />
</Layout>
