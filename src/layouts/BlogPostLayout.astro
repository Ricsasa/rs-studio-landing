---
import Layout from "@/layouts/Layout.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, cover, coverAlt } = post.data;

const ogImage = cover && Astro.site ? new URL(cover.src, Astro.site).href : undefined;
---

<Layout title={title} description={description} ogType="article" ogImage={ogImage} ogImageAlt={coverAlt}>
  <slot />
</Layout>
