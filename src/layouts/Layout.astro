---
import "@/styles/global.css";
import i18n from "i18next";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { getLocaleOptions } from "@/i18n/locales";
import { getLocalizedPathname } from "astro-react-i18next/utils";

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL. Defaults to the site monogram. */
  ogImage?: string;
  ogImageAlt?: string;
  /** "website" for every existing page, "article" for blog posts. */
  ogType?: string;
  /** Defaults to the current page's own URL. */
  canonicalURL?: string;
}

const {
  title = i18n.t("meta.title"),
  description = i18n.t("meta.description"),
  ogImage: ogImageProp,
  ogImageAlt,
  ogType = "website",
  canonicalURL,
} = Astro.props;

// `Astro.site` is only set once the `site` option is configured; without it
// these stay relative rather than emitting a broken absolute URL.
const canonical = Astro.site
  ? canonicalURL
    ? new URL(canonicalURL)
    : new URL(Astro.url.pathname, Astro.site)
  : undefined;
const usingDefaultOgImage = !ogImageProp;
const ogImage = ogImageProp
  ? new URL(ogImageProp)
  : Astro.site
    ? new URL("/monogram.png", Astro.site)
    : undefined;

// Every locale this page also exists in, for hreflang. Crawlers ignore
// relative hreflang hrefs, so these are only emitted once `site` gives us an
// origin to resolve against.
const alternates = Astro.site
  ? getLocaleOptions().map((locale) => ({
      code: locale.code,
      href: new URL(getLocalizedPathname(Astro.url.pathname, locale.code), Astro.site).href,
    }))
  : [];
---

<!doctype html>
<html lang={i18n.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <meta name="theme-color" content="#ece8d9" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical.href} />}
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.code} href={alternate.href} />
      ))
    }

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="RS Studio" />
    <meta property="og:locale" content={i18n.language.replace("-", "_")} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    {ogImage && <meta property="og:image" content={ogImage.href} />}
    {ogImage && usingDefaultOgImage && <meta property="og:image:width" content="320" />}
    {ogImage && usingDefaultOgImage && <meta property="og:image:height" content="320" />}
    {ogImage && (
      <meta property="og:image:alt" content={ogImageAlt ?? i18n.t("hero.monogramAlt")} />
    )}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage.href} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/*
      Archivo alone, at three weights: 400 for prose, 500 for titles and UI,
      600 where a title needs a little more presence. The Archivo Black cut
      the earlier design used is deliberately not loaded — nothing on the page
      is set heavy enough to need it, and it was a request on every page load.
    */}
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{i18n.t("nav.skipToContent")}</a>
    <slot />
    <WhatsAppButton />
  </body>
</html>

<script>
  import { initCardAnimations } from "@/scripts/cardAnimation";
  import { initSectionParallax } from "@/scripts/sectionParallax";

  initCardAnimations();
  initSectionParallax();
</script>
