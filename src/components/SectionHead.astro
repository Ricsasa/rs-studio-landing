---
interface Props {
  title: string;
  meta?: string;
  tone?: "paper" | "dark";
  id?: string;
  class?: string;
}

const { title, meta, tone = "paper", id, class: className } = Astro.props;

const dark = tone === "dark";
---

<div class:list={[dark ? "border-reverse-rule" : "border-rule", "border-t pt-6", className]}>
  {meta && <span class:list={["eyebrow", dark ? "text-lichen" : "text-mute"]}>{meta}</span>}

  <h2 id={id} class:list={["max-w-[20ch] text-section display-face text-balance", meta && "mt-4"]}>
    {title}
  </h2>
</div>
