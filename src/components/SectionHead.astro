---
/**
 * The standard section masthead: a hairline, the annotation that names the
 * section, then the title.
 *
 * Every section on the site uses this, so the page reads as one document
 * rather than as a stack of independently styled blocks. The rule sits above
 * the title rather than under it — with no borders around the content below,
 * the line is what tells you a new section has started.
 */
interface Props {
  title: string;
  /** Optional annotation printed above the title. */
  meta?: string;
  /** `dark` reverses the rule and annotation out of a pine plate. */
  tone?: "paper" | "dark";
  id?: string;
  class?: string;
}

const { title, meta, tone = "paper", id, class: className } = Astro.props;

const dark = tone === "dark";
---

<div class:list={[dark ? "border-reverse-rule" : "border-rule", "border-t pt-6", className]}>
  {meta && <span class:list={["eyebrow", dark ? "text-lichen" : "text-mute"]}>{meta}</span>}

  <h2 id={id} class:list={["max-w-[20ch] text-section display-face text-balance", meta && "mt-4"]}>
    {title}
  </h2>
</div>
