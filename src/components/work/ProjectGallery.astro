---
import i18n from "i18next";
import Carousel from "@/components/carousel.astro";
import type { Project } from "@/content/projects";

interface Props {
  project: Project;
  /** Resolved from disk by the page, since screenshots are not locale data. */
  images: string[];
}

const { project, images } = Astro.props;

const screenshots = images.map((src, index) => ({
  src,
  alt: i18n.t("projectPage.screenshotAlt", { title: project.title, index: index + 1 }),
}));

const labels = {
  previous: i18n.t("carousel.previous"),
  next: i18n.t("carousel.next"),
  open: i18n.t("carousel.open"),
  close: i18n.t("carousel.close"),
  // A function, so i18next does the interpolation rather than the component
  // string-replacing a `{{index}}` that i18next would already have consumed.
  goTo: (index: number) => i18n.t("carousel.goTo", { index }),
};
---

{
  screenshots.length > 0 && (
    <section class="bg-substrate px-gutter py-section">
      <div class="mx-auto w-full max-w-content">
        <h2 class="eyebrow border-t border-rule pt-6 text-moss">
          {i18n.t("projectPage.galleryLabel")}
        </h2>

        <Carousel
          images={screenshots}
          id="project-gallery"
          label={i18n.t("projectPage.galleryRegion")}
          labels={labels}
          class="gsap-reveal-card mt-heading"
          stageClass="bg-paper"
          controlClass="bg-paper/90 p-2.5 text-graphite transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-current"
          dotClass="h-px w-6 bg-rule-strong transition-colors group-hover/dot:bg-ink group-aria-current/dot:bg-moss"
          screenClass="halftone-fine opacity-15"
        />
      </div>
    </section>
  )
}
