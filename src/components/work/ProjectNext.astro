---
import i18n from "i18next";
import { projectPath } from "@/i18n/routing";
import type { Project } from "@/content/projects";

interface Props {
  next: Project;
  nextSlug: string;
}

const { next, nextSlug } = Astro.props;
---

<section class="bg-paper px-gutter py-section">
  <div class="mx-auto w-full max-w-content">
    <a
      href={projectPath(nextSlug)}
      class="group flex flex-wrap items-end justify-between gap-x-8 gap-y-4 border-t border-rule pt-8"
    >
      <div>
        <span class="eyebrow text-mute">{i18n.t("projectPage.nextLabel")}</span>
        <div class="mt-3 text-service display-face">
          <span class="rule-wipe group-hover:rule-wipe-on">{next.title}</span>
        </div>
      </div>

      <span
        aria-hidden="true"
        class="text-moss transition-transform duration-200 group-hover:translate-x-1"
      >
        &#8594;
      </span>
    </a>
  </div>
</section>
