---
import i18n from "i18next";
import type { Project } from "@/content/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section class="bg-paper px-gutter py-section">
  <div class="mx-auto w-full max-w-content">
    <div class="grid grid-cols-1 gap-split wide:grid-cols-[0.75fr_1.25fr]">
      <div>
        <h2 class="eyebrow border-t border-rule pt-6 text-moss">
          {i18n.t("projectPage.overviewLabel")}
        </h2>

        {
          project.technologies && (
            <>
              <h3 class="eyebrow mt-heading border-t border-rule pt-6 text-mute">
                {i18n.t("projectPage.stackLabel")}
              </h3>

              <ul class="m-0 mt-4 list-none space-y-2 p-0">
                {project.technologies.map((tech) => (
                  <li class="text-lead-sm text-ink-soft">{tech}</li>
                ))}
              </ul>
            </>
          )
        }
      </div>

      <div class="max-w-prose text-lead text-pretty text-graphite [&>p]:mt-6 [&>p:first-child]:mt-0 [&_em]:italic [&_strong]:font-medium [&_strong]:text-ink">
        <slot />
      </div>
    </div>
  </div>
</section>
