---
import i18n from "i18next";
import LanguageToggle from "./LanguageToggle.astro";
import { blogPath, homePath, isHome, sectionHref } from "@/i18n/routing";

const pathname = Astro.url.pathname;
const onHome = isHome(pathname);

// `blog` is a real route, not an in-page hash, so it skips `sectionHref` and
// carries its own `href` — everything else still scrolls on the landing page
// and routes home first anywhere else.
const links = [
  { hash: "#work", key: "nav.work" },
  { hash: "#manifesto", key: "nav.manifesto" },
  { hash: "#services", key: "nav.services" },
  { hash: "#process", key: "nav.process" },
  { hash: undefined, key: "nav.blog", href: blogPath() },
  { hash: "#contact", key: "nav.contact" },
].map((link) => ({ ...link, href: link.href ?? sectionHref(pathname, link.hash!) }));

// On the landing page this is an in-page scroll; elsewhere it routes home.
const logoHref = onHome ? "#top" : homePath();
---

{/*
  A hairline and a wash of paper, nothing else: the cell borders that used to
  divide the logo, nav and controls are gone, so the header reads as a margin
  rather than as a toolbar.
*/}
<header class="sticky top-0 z-(--z-header) border-b border-rule bg-paper/92 backdrop-blur-sm">
  <div class="mx-auto flex w-full max-w-content items-center justify-between gap-6 px-gutter py-4">
    <a href={logoHref} class="flex items-center transition-opacity duration-200 hover:opacity-70">
      <img
        src="/logo.svg"
        alt={i18n.t("nav.logoAlt")}
        width="1261"
        height="209"
        class="block h-5 w-auto"
      />
    </a>

    {/* The accent underline marks the section you are actually in. */}
    <nav class="hidden items-center gap-[clamp(16px,2.2vw,32px)] md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-nav-link
            data-section={link.hash?.slice(1)}
            class="rule-wipe text-lead-sm text-graphite transition-colors duration-200 hover:text-ink hover:rule-wipe-on aria-current:text-moss aria-current:rule-wipe-on"
          >
            {i18n.t(link.key)}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <LanguageToggle />

      {/* Opens the drawer only. The drawer covers this row and closes itself. */}
      <button
        type="button"
        id="menu-toggle"
        aria-label={i18n.t("nav.menu")}
        aria-expanded="false"
        aria-controls="mobile-drawer"
        class="-mr-2 flex h-11 w-11 flex-col items-center justify-center gap-1.5 transition-opacity duration-200 hover:opacity-70 md:hidden"
      >
        <span class="block h-px w-5 bg-ink"></span>
        <span class="block h-px w-5 bg-ink"></span>
      </button>
    </div>
  </div>
</header>

{/*
  Sits *over* the sticky header rather than under it. Locking body scroll while
  the page is scrolled down takes the sticky header with it on mobile, so a
  control living up there — the old X — became unreachable exactly when it was
  needed. The drawer now covers the header (and the floating WhatsApp button)
  and carries its own close control, so it depends on nothing outside itself.
*/}
<div id="mobile-drawer" class="fixed inset-0 z-(--z-drawer) hidden flex-col bg-paper md:hidden">
  {/* Restates the header row it is covering, with the X where the toggle was. */}
  <div class="flex items-center justify-between gap-6 px-gutter py-4">
    <a href={logoHref} class="flex items-center transition-opacity duration-200 hover:opacity-70">
      <img
        src="/logo.svg"
        alt={i18n.t("nav.logoAlt")}
        width="1261"
        height="209"
        class="block h-5 w-auto"
      />
    </a>

    <div class="flex items-center gap-2">
      {/* The header's copy is covered, so the drawer carries the switch itself. */}
      <LanguageToggle />

      <button
        type="button"
        id="menu-close"
        aria-label={i18n.t("nav.closeMenu")}
        class="-mr-2 flex h-11 w-11 items-center justify-center transition-opacity duration-200 hover:opacity-70"
      >
        {/* Two hairlines crossed — the same 20px bar the toggle draws, rotated. */}
        <span aria-hidden="true" class="relative block h-5 w-5">
          <span class="absolute top-1/2 left-0 block h-px w-5 rotate-45 bg-ink"></span>
          <span class="absolute top-1/2 left-0 block h-px w-5 -rotate-45 bg-ink"></span>
        </span>
      </button>
    </div>
  </div>

  <div class="mt-6">
    {
      links.map((link) => (
        <a
          href={link.href}
          class="block border-b border-rule px-gutter py-5 transition-colors duration-200 hover:text-moss"
        >
          <span class="text-service display-face">{i18n.t(link.key)}</span>
        </a>
      ))
    }
  </div>

  <div class="mt-auto px-gutter py-8">
    <span class="label text-mute">{i18n.t("contact.copyright")}</span>
  </div>
</div>

<script>
  const toggle = document.getElementById("menu-toggle");
  const drawer = document.getElementById("mobile-drawer");

  if (toggle && drawer) {
    const setOpen = (open: boolean) => {
      // Escape and the desktop breakpoint both close unconditionally; without
      // this they would pull focus back to the toggle when nothing was open.
      if (open === !drawer.classList.contains("hidden")) return;

      toggle.setAttribute("aria-expanded", String(open));
      drawer.classList.toggle("hidden", !open);
      drawer.classList.toggle("flex", open);
      document.body.classList.toggle("overflow-hidden", open);

      // Focus follows the panel, so the close button is the next tab stop in
      // and the toggle is where focus lands on the way back out.
      if (open) document.getElementById("menu-close")?.focus();
      else toggle.focus();
    };

    toggle.addEventListener("click", () => setOpen(true));
    document.getElementById("menu-close")?.addEventListener("click", () => setOpen(false));

    drawer.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });

    // The drawer is md:hidden, so crossing into desktop must also drop the scroll lock.
    window.matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Mark the section currently in view. Only the landing page has the sections
  // inline; elsewhere the nav links route home and nothing is current.
  const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
  const sections = [...navLinks]
    .map((link) => document.getElementById(link.dataset.section ?? ""))
    .filter((section): section is HTMLElement => section !== null);

  if (sections.length) {
    const setCurrent = (id: string | null) => {
      navLinks.forEach((link) => {
        if (link.dataset.section === id) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });
    };

    const visible = new Set<string>();

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        });

        // Several sections can straddle the band at once; the first in document
        // order is the one the reader has arrived at.
        const current = sections.find((section) => visible.has(section.id));
        setCurrent(current?.id ?? null);
      },
      // A band just under the sticky header, so "current" means "at the top of
      // the viewport" rather than "anywhere on screen".
      { rootMargin: "-72px 0px -70% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
