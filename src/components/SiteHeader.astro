---
import i18n from "i18next";
import LanguageToggle from "./LanguageToggle.astro";
import { homePath, isHome, sectionHref } from "@/i18n/routing";

const pathname = Astro.url.pathname;
const onHome = isHome(pathname);

const links = [
  { hash: "#work", key: "nav.work" },
  { hash: "#services", key: "nav.services" },
  { hash: "#process", key: "nav.process" },
  { hash: "#stack", key: "nav.stack" },
  { hash: "#contact", key: "nav.contact" },
].map((link) => ({ ...link, href: sectionHref(pathname, link.hash) }));

// On the landing page this is an in-page scroll; elsewhere it routes home.
const logoHref = onHome ? "#top" : homePath();
---

<header class="sticky top-0 z-(--z-header) border-b-2 border-ink bg-paper">
  <div class="flex items-stretch justify-between">
    <a
      href={logoHref}
      class="flex items-center gap-1.5 border-r border-rule px-gutter py-3.5 transition-colors duration-200 hover:bg-ink hover:text-paper"
    >
      <img
        src="/logo.svg"
        alt={i18n.t("nav.logoAlt")}
        width="1261"
        height="209"
        class="block h-5 w-auto"
      />
    </a>

    <nav class="hidden items-stretch md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-nav-link
            data-section={link.hash.slice(1)}
            class="group relative flex items-center border-l border-rule px-[clamp(12px,1.8vw,24px)] text-ink-soft transition-colors duration-200 hover:bg-ink hover:text-paper aria-current:text-ink"
          >
            {/* The accent rule marks the section you are actually in. */}
            <span
              aria-hidden="true"
              class="absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-moss transition-transform duration-200 group-aria-current:scale-x-100"
            />
            <span class="label font-medium">{i18n.t(link.key)}</span>
          </a>
        ))
      }
    </nav>

    <div class="flex items-stretch border-l border-rule">
      <div class="flex items-center px-[clamp(12px,2vw,20px)]">
        <LanguageToggle />
      </div>

      <button
        type="button"
        id="menu-toggle"
        aria-label={i18n.t("nav.menu")}
        aria-expanded="false"
        aria-controls="mobile-drawer"
        class="flex w-14 flex-col items-center justify-center gap-1.5 border-l border-rule transition-colors duration-200 hover:bg-ink md:hidden"
      >
        <span class="block h-0.5 w-5 bg-ink"></span>
        <span class="block h-0.5 w-5 bg-ink"></span>
      </button>
    </div>
  </div>
</header>

{/* Sits under the sticky header (z-40 vs z-50) so it never needs to know the header's exact height. */}
<div id="mobile-drawer" class="fixed inset-0 z-(--z-drawer) hidden flex-col bg-paper pt-20 md:hidden">
  <div class="border-t border-rule">
    {
      links.map((link) => (
        <a
          href={link.href}
          class="block border-b border-rule px-gutter py-5 transition-colors duration-200 hover:bg-ink hover:text-paper"
        >
          <span class="text-service display-face">{i18n.t(link.key)}</span>
        </a>
      ))
    }
  </div>

  <div class="mt-auto px-gutter py-6">
    <span class="label text-mute">{i18n.t("contact.copyright")}</span>
  </div>
</div>

<script>
  const toggle = document.getElementById("menu-toggle");
  const drawer = document.getElementById("mobile-drawer");

  if (toggle && drawer) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      drawer.classList.toggle("hidden", !open);
      drawer.classList.toggle("flex", open);
      document.body.classList.toggle("overflow-hidden", open);
    };

    toggle.addEventListener("click", () => setOpen(drawer.classList.contains("hidden")));

    drawer.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });

    // The drawer is md:hidden, so crossing into desktop must also drop the scroll lock.
    window.matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Mark the section currently in view. Only the landing page has the sections
  // inline; elsewhere the nav links route home and nothing is current.
  const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
  const sections = [...navLinks]
    .map((link) => document.getElementById(link.dataset.section ?? ""))
    .filter((section): section is HTMLElement => section !== null);

  if (sections.length) {
    const setCurrent = (id: string | null) => {
      navLinks.forEach((link) => {
        if (link.dataset.section === id) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });
    };

    const visible = new Set<string>();

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        });

        // Several sections can straddle the band at once; the first in document
        // order is the one the reader has arrived at.
        const current = sections.find((section) => visible.has(section.id));
        setCurrent(current?.id ?? null);
      },
      // A band just under the sticky header, so "current" means "at the top of
      // the viewport" rather than "anywhere on screen".
      { rootMargin: "-72px 0px -70% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
