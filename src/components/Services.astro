---
import i18n from "i18next";
import { tList } from "@/i18n/t";
import SectionHead from "./SectionHead.astro";
import OrganicField from "./OrganicField.astro";
import Icon, { type IconName } from "./Icon.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { servicePath, type ServiceKey } from "@/i18n/routing";
import { whatsappHref } from "@/lib/whatsapp";

type Service = { key: ServiceKey; title: string; body: string };

const services = tList<Service>("services.items");

const ICONS: Record<ServiceKey, IconName> = {
  landingPages: "landing-pages",
  wordpressEcommerce: "ecommerce",
  businessManagementTool: "business-tool",
  digitalMarketing: "marketing",
};

const email = i18n.t("contact.email");
---

<section id="services" data-reveal class="relative isolate bg-substrate px-gutter parallax-plate">
  <OrganicField variant="caseStudy" />

  <div class="relative mx-auto w-full max-w-content">
    <SectionHead title={i18n.t("services.title")} meta={i18n.t("services.meta")} />

    <p class="mt-heading max-w-prose text-lead text-pretty text-graphite">
      {i18n.t("services.intro")}
    </p>

    <div class="mt-heading grid grid-cols-1 gap-x-grid gap-y-flow md:grid-cols-2 wide:grid-cols-2">
      {
        services.map((service) => (
          <a
            href={servicePath(service.key)}
            class="group block border-t border-rule pt-8 transition-colors duration-200 hover:border-moss"
          >
            <Icon name={ICONS[service.key]} class="h-14 w-14 text-moss" />
            <h3 class="mt-6 text-section display-face">{service.title}</h3>
            <p class="mt-4 text-lead text-pretty text-graphite">{service.body}</p>

            <span class="mt-4 inline-flex items-center gap-2 text-lead-sm font-medium text-moss">
              {i18n.t("services.readMore")}
              <span
                aria-hidden="true"
                class="transition-transform duration-200 group-hover:translate-x-1"
              >
                &#8594;
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
