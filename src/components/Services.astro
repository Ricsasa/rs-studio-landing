---
import i18n from "i18next";
import { tList } from "@/i18n/t";
import SectionHead from "./SectionHead.astro";
import OrganicField from "./OrganicField.astro";
import Icon, { type IconName } from "./Icon.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { servicePath, type ServiceKey } from "@/i18n/routing";
import { whatsappHref } from "@/lib/whatsapp";

type Service = { key: ServiceKey; title: string; body: string };

const services = tList<Service>("services.items");

const ICONS: Record<ServiceKey, IconName> = {
  landingPages: "landing-pages",
  wordpressEcommerce: "ecommerce",
  businessManagementTool: "business-tool",
  digitalMarketing: "marketing",
};

const email = i18n.t("contact.email");
---

<section id="services" data-reveal class="relative isolate bg-paper px-gutter parallax-plate">
  <OrganicField variant="caseStudy" />

  <div class="relative mx-auto w-full max-w-content">
    <SectionHead title={i18n.t("services.title")} meta={i18n.t("services.meta")} />

    <p class="mt-heading max-w-prose text-lead text-pretty text-graphite">
      {i18n.t("services.intro")}
    </p>

    <div class="mt-heading grid grid-cols-1 gap-x-grid gap-y-flow md:grid-cols-2 wide:grid-cols-2">
      {
        services.map((service) => (
          <a
            href={servicePath(service.key)}
            class="group block border-t border-rule pt-8 transition-colors duration-200 hover:border-moss"
          >
            <Icon name={ICONS[service.key]} class="h-14 w-14 text-moss" />
            <h3 class="mt-6 text-section display-face">{service.title}</h3>
            <p class="mt-4 text-lead text-pretty text-graphite">{service.body}</p>

            <span class="mt-4 inline-flex items-center gap-2 text-lead-sm font-medium text-moss">
              {i18n.t("services.readMore")}
              <span
                aria-hidden="true"
                class="transition-transform duration-200 group-hover:translate-x-1"
              >
                &#8594;
              </span>
            </span>
          </a>
        ))
      }
    </div>

    <div class="mt-cta-lg border-t border-rule pt-heading">
      <h3 class="max-w-[20ch] text-section display-face text-balance">
        {i18n.t("services.cta.title")}
      </h3>

      <p class="mt-4 max-w-prose text-lead text-pretty text-graphite">
        {i18n.t("services.cta.intro")}
      </p>

      <div class="mt-cta flex flex-wrap items-center gap-3">
        <a
          href={whatsappHref(i18n.t("services.cta.whatsappMessage"))}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-13 items-center gap-2.5 bg-moss px-6 py-4 text-paper transition-colors duration-200 hover:bg-pine active:scale-[0.99]"
        >
          <WhatsAppIcon class="h-4.5 w-4.5" />
          <span class="text-lead-sm font-medium">{i18n.t("cta.requestProposal")}</span>
        </a>

        <a
          href={`mailto:${email}`}
          class="inline-flex min-h-13 items-center border border-rule px-6 py-4 transition-colors duration-200 hover:border-moss hover:text-moss"
        >
          <span class="text-lead-sm font-medium">Email</span>
        </a>
      </div>
    </div>
  </div>
</section>
