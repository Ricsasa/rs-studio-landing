---
import i18n from "i18next";
import { tList } from "@/i18n/t";
import SectionHead from "./SectionHead.astro";
import OrganicField from "./OrganicField.astro";

type Step = { num: string; title: string; body: string };

const steps = tList<Step>("process.steps");
---

<section id="process" class="relative isolate bg-substrate px-gutter parallax-plate">
  <OrganicField variant="process" />

  <div class="relative mx-auto w-full max-w-content">
    <SectionHead title={i18n.t("process.title")} meta={i18n.t("process.meta")} />

    <div class="mt-heading grid grid-cols-1 gap-split wide:grid-cols-[0.75fr_1.25fr]">
      <p class="max-w-[34ch] text-lead text-pretty text-graphite">
        {i18n.t("process.intro")}
      </p>

      <ol class="m-0 list-none p-0">
        {
          steps.map((step) => (
            <li class="grid grid-cols-[auto_1fr] gap-x-[clamp(20px,3vw,48px)] border-t border-rule py-7 last:border-b last:border-rule">
              <span class="label pt-1 text-moss">{step.num}</span>

              <div>
                <h3 class="text-step display-face">{step.title}</h3>
                <p class="mt-2 max-w-[52ch] text-lead-sm text-pretty text-graphite">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
