---
import i18n from "i18next";
import OrganicField from "@/components/OrganicField.astro";

interface Props {
  deliverables: string[];
}

const { deliverables } = Astro.props;
---

<section class="relative isolate bg-substrate px-gutter py-section">
  <OrganicField variant="stack" />

  <div class="relative mx-auto w-full max-w-content">
    <h2 class="eyebrow border-t border-rule pt-6 text-moss">
      {i18n.t("servicePage.deliverablesLabel")}
    </h2>

    <ul class="m-0 mt-6 grid list-none grid-cols-1 gap-x-grid gap-y-2 p-0 sm:grid-cols-2 wide:grid-cols-3">
      {deliverables.map((item) => <li class="text-lead-sm text-ink-soft">{item}</li>)}
    </ul>
  </div>
</section>
