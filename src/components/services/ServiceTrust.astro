---
import i18n from "i18next";
import SectionHead from "@/components/SectionHead.astro";
import Icon from "@/components/Icon.astro";
import OrganicField from "@/components/OrganicField.astro";

interface Props {
  title: string;
  body: string;
  items: string[];
  quote: string;
  background?: "paper" | "substrate";
}

const { title, body, items, quote, background = "paper" } = Astro.props;
const bgClass = background === "substrate" ? "bg-substrate" : "bg-paper";
---

<section class={`relative isolate ${bgClass} px-gutter py-section`}>
  <OrganicField variant="hero" />

  <div class="relative mx-auto w-full max-w-content">
    <div class="grid grid-cols-1 gap-split wide:grid-cols-[0.75fr_1.25fr]">
      <SectionHead title={i18n.t("servicePage.trustLabel")} />

      <div class="max-w-prose">
        <h3 class="text-step display-face text-balance">{title}</h3>
        <p class="mt-4 text-lead text-pretty text-graphite">{body}</p>

        <ul class="m-0 mt-heading grid list-none grid-cols-1 gap-x-grid gap-y-2 p-0 sm:grid-cols-2">
          {
            items.map((item) => (
              <li class="flex items-start gap-3 text-lead-sm text-ink-soft">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-moss" />
                {item}
              </li>
            ))
          }
        </ul>

        <p class="mt-heading max-w-prose border-t border-rule pt-6 text-lead text-pretty text-graphite italic">
          {quote}
        </p>
      </div>
    </div>
  </div>
</section>
