---
import i18n from "i18next";
import SectionHead from "@/components/SectionHead.astro";
import Icon from "@/components/Icon.astro";
import OrganicField from "@/components/OrganicField.astro";

interface Props {
  benefits: string[];
}

const { benefits } = Astro.props;
---

<section class="relative isolate bg-substrate px-gutter py-section">
  <OrganicField variant="services" />

  <div class="relative mx-auto w-full max-w-content">
    <SectionHead title={i18n.t("servicePage.benefitsLabel")} />

    <div class="mt-heading grid grid-cols-1 gap-x-grid gap-y-flow md:grid-cols-2 wide:grid-cols-2">
      {
        benefits.map((benefit) => (
          <div class="flex items-start gap-4 border-t border-rule pt-8 md:block md:gap-0">
            <Icon name="check" class="h-10 w-10 shrink-0 text-moss" />
            <p class="text-lead text-pretty text-graphite md:mt-6">{benefit}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
