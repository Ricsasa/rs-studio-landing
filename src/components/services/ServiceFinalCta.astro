---
import i18n from "i18next";
import WhatsAppIcon from "@/components/WhatsAppIcon.astro";
import OrganicField from "@/components/OrganicField.astro";
import { whatsappHref } from "@/lib/whatsapp";

interface Props {
  whatsappMessage: string;
}

const { whatsappMessage } = Astro.props;
const email = i18n.t("contact.email");
---

<section class="relative isolate bg-paper px-gutter py-section">
  <OrganicField variant="hero" />

  <div class="relative mx-auto w-full max-w-content border-t border-rule pt-heading">
    <h2 class="max-w-[18ch] text-headline display-face text-balance">
      {i18n.t("servicePage.ctaTitle")}
    </h2>

    <p class="mt-lead max-w-prose text-lead text-pretty text-graphite">
      {i18n.t("servicePage.ctaIntro")}
    </p>

    <div class="mt-cta-lg flex flex-wrap items-center gap-3">
      <a
        href={whatsappHref(whatsappMessage)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-12 items-center gap-2.5 bg-moss px-6 py-3.5 text-paper transition-colors duration-200 hover:bg-pine active:scale-[0.99]"
      >
        <WhatsAppIcon class="h-4.5 w-4.5" />
        <span class="text-lead-sm font-medium">{i18n.t("cta.requestProposal")}</span>
      </a>

      <a
        href={`mailto:${email}`}
        class="inline-flex min-h-12 items-center border border-rule px-6 py-3.5 transition-colors duration-200 hover:border-moss hover:text-moss"
      >
        <span class="text-lead-sm font-medium">Email</span>
      </a>
    </div>
  </div>
</section>
