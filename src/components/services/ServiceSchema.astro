---
interface Props {
  name: string;
  description: string;
  url: string;
}

const { name, description, url } = Astro.props;

const json = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name,
  description,
  url,
  provider: {
    "@type": "Organization",
    name: "RS Studio",
    url: "https://rs-studio.dev",
  },
});
---

<script type="application/ld+json" set:html={json} />
