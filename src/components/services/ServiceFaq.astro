---
import i18n from "i18next";
import SectionHead from "@/components/SectionHead.astro";
import OrganicField from "@/components/OrganicField.astro";

interface Props {
  faq: { question: string; answer: string }[];
}

const { faq } = Astro.props;
---

<section class="relative isolate bg-paper px-gutter py-section">
  <OrganicField variant="work" />

  <div class="relative mx-auto w-full max-w-content">
    <SectionHead title={i18n.t("servicePage.faqLabel")} />

    <div class="mt-heading">
      {
        faq.map((item) => (
          <details class="group border-t border-rule py-6 last:border-b last:border-rule">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 [&::-webkit-details-marker]:hidden">
              <span class="text-step display-face">{item.question}</span>
              <span aria-hidden="true" class="relative h-4 w-4 shrink-0 text-moss">
                <span class="absolute top-1/2 left-1/2 h-px w-4 -translate-x-1/2 -translate-y-1/2 bg-current" />
                <span class="absolute top-1/2 left-1/2 h-4 w-px -translate-x-1/2 -translate-y-1/2 bg-current group-open:hidden" />
              </span>
            </summary>

            <p class="mt-4 max-w-prose text-lead-sm text-pretty text-graphite">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
