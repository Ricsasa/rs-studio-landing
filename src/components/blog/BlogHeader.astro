---
import i18n from "i18next";
import { blogPath } from "@/i18n/routing";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;

const dateLabel = new Intl.DateTimeFormat(i18n.language, {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(pubDate);
---

<section class="relative isolate bg-paper px-gutter pt-10 pb-hero-bottom">
  <div class="relative mx-auto w-full max-w-content">
    <a
      href={blogPath()}
      class="group inline-flex items-center gap-2 text-lead-sm text-graphite transition-colors duration-200 hover:text-ink"
    >
      <span
        aria-hidden="true"
        class="text-moss transition-transform duration-200 group-hover:-translate-x-1"
      >
        &#8592;
      </span>
      {i18n.t("blog.back")}
    </a>
    <h1 class="mt-hero-top max-w-[18ch] text-display display-face text-balance">{title}</h1>
    <p class="mt-lead max-w-prose text-lead text-pretty text-graphite">{description}</p>
    <div class="mt-cta flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-rule pt-6">
      <span class="label text-mute">{dateLabel}</span>
      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <a href={`${blogPath()}?tag=${encodeURIComponent(tag)}`} class="tag">
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
