---
import i18n from "i18next";
import { tList } from "@/i18n/t";
import SectionHead from "./SectionHead.astro";
import OrganicField from "./OrganicField.astro";

type StackGroup = { label: string; items: string[] };

const groups = tList<StackGroup>("stack.groups");
---

<section id="stack" class="relative isolate bg-paper px-gutter parallax-plate">
  <OrganicField variant="stack" />

  <div class="relative mx-auto w-full max-w-content">
    <SectionHead title={i18n.t("stack.title")} meta={i18n.t("stack.caption")} />

    <div class="mt-heading grid grid-cols-2 gap-x-grid gap-y-flow md:grid-cols-4">
      {
        groups.map((group) => (
          <div class="border-t border-rule pt-6">
            <h3 class="eyebrow text-moss">{group.label}</h3>

            <ul class="m-0 mt-4 list-none space-y-2 p-0">
              {group.items.map((item) => (
                <li class="text-lead-sm text-ink-soft">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
