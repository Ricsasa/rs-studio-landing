---
// Full-screen intro overlay: the monogram on a blank sheet with a hairline
// progress rule, ~1.5s, then wipes away to reveal the hero.
---

<div id="intro-overlay" data-intro-overlay aria-hidden="true">
  <div id="intro-plate">
    <img
      id="intro-monogram"
      src="/monogram.png"
      alt=""
      width="320"
      height="320"
      decoding="sync"
      fetchpriority="high"
    />
  </div>

  <div id="intro-bar"><span id="intro-bar-fill"></span></div>
</div>

<style is:global>
  #intro-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    display: grid;
    grid-template-rows: 1fr auto;
    background: var(--color-paper);
    border-radius: 0;
    will-change: transform;
  }

  #intro-plate {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(18px, 4vw, 32px);
  }

  #intro-monogram {
    width: clamp(120px, 18vw, 200px);
    height: auto;
    border-radius: 0;
  }

  /*
   * Progress rule. A hairline rather than a bar: it is the only accent on an
   * otherwise blank sheet, and at 6px it read as a loading UI.
   */
  #intro-bar {
    height: 1px;
    margin: 0 var(--spacing-gutter) clamp(24px, 5vw, 40px);
    background: var(--color-rule);
  }

  #intro-bar-fill {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--color-moss);
    transform: scaleX(0);
    transform-origin: left center;
  }

  html.intro-active,
  html.intro-active body {
    overflow: hidden;
  }

  /* Skipped intro: hidden before first paint, then removed by the script. */
  html[data-intro-done="true"] #intro-overlay {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #intro-overlay {
      display: none;
    }
  }
</style>

<script is:inline>
  // The intro belongs to a fresh arrival, not to every page view: navigating
  // back to the home page from a project would otherwise replay it. A session
  // flag marks "already seen in this tab", and an explicit reload always
  // overrides it so refreshing the page still shows the animation.
  (function () {
    var KEY = "rs-intro-seen";
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    var seen = false;
    var reloaded = false;
    try {
      seen = sessionStorage.getItem(KEY) === "1";
      sessionStorage.setItem(KEY, "1");
    } catch (e) {
      // Private mode or blocked storage: fall back to always playing.
    }

    var nav = performance.getEntriesByType("navigation")[0];
    reloaded = nav ? nav.type === "reload" : false;

    if (reduced || (seen && !reloaded)) {
      // Marked before any module script runs, so the hero animation sees the
      // flag on its first read and starts without waiting for intro:complete.
      document.documentElement.dataset.introDone = "true";
      return;
    }

    // Lock scroll before paint so the intro never scrolls with the page.
    document.documentElement.classList.add("intro-active");
  })();
</script>

<script>
  import { initIntro } from "@/scripts/intro";

  initIntro();
</script>
