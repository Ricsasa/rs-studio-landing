---
// Full-screen intro overlay: the monogram on a blank sheet with a hairline
// progress rule, ~1.5s, then wipes away to reveal the hero.
---

<div id="intro-overlay" data-intro-overlay aria-hidden="true">
  <div id="intro-plate">
    <img
      id="intro-monogram"
      src="/monogram.png"
      alt=""
      width="320"
      height="320"
      decoding="sync"
      fetchpriority="high"
    />
  </div>

  <div id="intro-bar"><span id="intro-bar-fill"></span></div>
</div>

<style is:global>
  #intro-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    display: grid;
    grid-template-rows: 1fr auto;
    background: var(--color-paper);
    border-radius: 0;
    will-change: transform;
  }

  #intro-plate {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(18px, 4vw, 32px);
  }

  #intro-monogram {
    width: clamp(120px, 18vw, 200px);
    height: auto;
    border-radius: 0;
  }

  /*
   * Progress rule. A hairline rather than a bar: it is the only accent on an
   * otherwise blank sheet, and at 6px it read as a loading UI.
   */
  #intro-bar {
    height: 1px;
    margin: 0 var(--spacing-gutter) clamp(24px, 5vw, 40px);
    background: var(--color-rule);
  }

  #intro-bar-fill {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--color-moss);
    transform: scaleX(0);
    transform-origin: left center;
  }

  html.intro-active,
  html.intro-active body {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    #intro-overlay {
      display: none;
    }
  }
</style>

<script is:inline>
  // Lock scroll before paint so the intro never scrolls with the page.
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.documentElement.classList.add("intro-active");
  }
</script>

<script>
  import { initIntro } from "@/scripts/intro";

  initIntro();
</script>
