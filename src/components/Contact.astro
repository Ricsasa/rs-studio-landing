---
import i18n from "i18next";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { whatsappHref } from "@/lib/whatsapp";

const email = i18n.t("contact.email");
---

{/*
  The single solid ink plate in the document. It closes the sheet the way a
  printed back cover does — same three colours, full coverage.
*/}
<section id="contact" class="bg-ink px-gutter py-section-lg text-reverse">
  <div class="mx-auto w-full max-w-content">
    {/* `sage` rather than `moss`: the accent needs more coverage to stay legible on ink. */}
    <span class="eyebrow text-sage">{i18n.t("nav.contact")}</span>

    <h2 class="mt-5 max-w-[18ch] text-headline display-face text-balance">
      {i18n.t("contact.title")}
    </h2>

    <p class="mt-lead max-w-prose text-lead text-pretty text-reverse-mute">
      {i18n.t("contact.intro")}
    </p>

    <div class="mt-cta-lg flex flex-wrap items-center gap-3">
      <a
        href={`mailto:${email}`}
        class="inline-flex min-h-13 items-center bg-paper px-6 py-4 text-ink transition-colors duration-200 hover:bg-sage active:scale-[0.99]"
      >
        <span class="text-lead-sm font-medium">{email}</span>
      </a>

      <a
        href={whatsappHref()}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-13 items-center gap-2.5 border border-reverse-rule px-6 py-4 transition-colors duration-200 hover:border-sage hover:text-sage"
      >
        <WhatsAppIcon class="h-4.5 w-4.5" />
        <span class="text-lead-sm font-medium">{i18n.t("whatsapp.cta")}</span>
      </a>
    </div>

    <footer class="mt-footer border-t border-reverse-rule pt-8">
      <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-6">
        <img
          src="/logo.svg"
          alt={i18n.t("nav.logoAlt")}
          width="1261"
          height="209"
          class="h-5 w-auto invert"
        />

        <div class="flex flex-wrap items-center gap-x-7 gap-y-3">
          <a
            href="https://www.facebook.com/rsstudiodev/"
            rel="noopener noreferrer"
            target="_blank"
            class="label text-reverse-mute transition-colors duration-200 hover:text-sage"
          >
            {i18n.t("contact.facebook")}
          </a>
          <a
            href={`mailto:${email}`}
            class="label text-reverse-mute transition-colors duration-200 hover:text-sage"
          >
            {i18n.t("contact.emailLabel")}
          </a>
          <span class="label text-reverse-mute">{i18n.t("contact.copyright")}</span>
        </div>
      </div>
    </footer>
  </div>
</section>
