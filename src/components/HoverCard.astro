---
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  icon: IconName;
  heading: string;
  items: string[];
}

const { icon, heading, items } = Astro.props;
---

<div class="group relative flex flex-col border border-rule p-8 transition-colors duration-200 hover:border-moss hover:bg-substrate">
  <Icon name={icon} class="h-10 w-10 text-moss transition-transform duration-200 group-hover:-translate-y-0.5" />

  <h4 class="mt-6 text-lead font-medium text-ink">{heading}</h4>

  <ul class="m-0 mt-6 list-none space-y-2 p-0">
    {
      items.map((item) => (
        <li class="flex items-start gap-3 text-lead-sm text-ink-soft">
          <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-moss" />
          {item}
        </li>
      ))
    }
  </ul>

  <div class="mt-auto border-t border-rule pt-6">
    <slot />
  </div>
</div>
