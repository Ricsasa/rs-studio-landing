---
import i18n from "i18next";
import SectionHead from "./SectionHead.astro";
import OrganicField from "./OrganicField.astro";
---

<section id="get-started" data-reveal class="relative isolate bg-paper px-gutter parallax-plate">
  <OrganicField variant="getStarted" />

  <div class="relative mx-auto w-full max-w-content">
    <SectionHead title={i18n.t("getStarted.title")} meta={i18n.t("getStarted.meta")} />
  </div>
</section>
