---
import i18n from "i18next";
import { tList } from "@/i18n/t";
import { projectPath } from "@/i18n/routing";
import SectionHead from "./SectionHead.astro";
import OrganicField from "./OrganicField.astro";
import { projectSlugs, projectScreenshots, projectScreenshotAlts, isCaseStudy, type Project } from "@/content/projects";

const projects = tList<Project>("projects", "projects");

const cards = projects.map((project, index) => {
  const caseStudy = isCaseStudy(project);

  return {
    project,
    // Case studies route internally; everything else follows its own href.
    href: caseStudy ? projectPath(projectSlugs[index]!) : (project.href ?? "#contact"),
    external: !caseStudy && Boolean(project.href?.startsWith("http")),
    label: caseStudy ? i18n.t("work.viewCase") : project.cta,
    thumbnail: projectScreenshots[index]?.[0],
    thumbnailAlt: projectScreenshotAlts[index]?.[0],
  };
});

const total = String(projects.length).padStart(2, "0");
---

<section id="work" class="relative isolate bg-substrate px-gutter parallax-plate">
  <OrganicField variant="work" />

  <div class="relative mx-auto w-full max-w-content">
    <SectionHead title={i18n.t("work.title")} meta={i18n.t("work.head")} />

    {/*
      No card containers: the screenshot is the object, and the type sits
      under it on open paper. Gaps do the separating that borders used to.
    */}
    <div class="mt-heading grid grid-cols-1 gap-x-grid gap-y-flow md:grid-cols-2 wide:grid-cols-2">
      {
        cards.map(({ project, href, external, label, thumbnail, thumbnailAlt }) => (
          <a
            href={href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
            class="group flex flex-col"
          >
            {thumbnail ? (
              <div class="relative overflow-hidden bg-substrate">
                <img
                  src={thumbnail}
                  alt={thumbnailAlt || i18n.t("projectPage.screenshotAlt", { title: project.title, index: 1 })}
                  loading="lazy"
                  decoding="async"
                  class="block aspect-16/10 w-full object-cover object-top transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.02]"
                />
                {/* Screenshots are photographic; the dot matrix prints them onto the page. */}
                <span aria-hidden="true" class="halftone-fine absolute inset-0 opacity-8" />
              </div>
            ) : (
              <div class="flex aspect-16/10 items-center justify-center bg-substrate">
                <span class="label text-mute">{i18n.t("work.shotPlaceholder")}</span>
              </div>
            )}

            <span class="label mt-5 text-mute">
              {project.category} · {project.year}
            </span>

            <h3 class="mt-2 text-subhead display-face">
              <span class="rule-wipe group-hover:rule-wipe-on">{project.title}</span>
            </h3>

            <p class="mt-2.5 text-lead-sm text-pretty text-graphite">
              {project.brief_description}
            </p>

            {project.technologies && (
              <p class="label mt-4 text-mute">{project.technologies.join(" · ")}</p>
            )}

            {/* `mt-auto`: the call to action lines up across a row of uneven cards. */}
            <span class="mt-auto flex items-center gap-2 pt-5 text-lead-sm font-medium">
              {label}
              <span
                aria-hidden="true"
                class="text-moss transition-transform duration-200 group-hover:translate-x-1"
              >
                &#8594;
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
