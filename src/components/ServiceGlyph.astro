---
export type GlyphName = "landingPages" | "ecommerce" | "businessTool" | "marketing" | "check";

interface Props {
  name: GlyphName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
  class:list={["block", className]}
>
  {
    name === "landingPages" && (
      <>
        <rect x="1.5" y="4.5" width="20" height="14" />
        <path d="M8.5 22.5h6M11.5 18.5v4" />
        <rect x="23.5" y="11.5" width="7" height="16" />
        <path d="M25.5 25.5h3" />
      </>
    )
  }

  {
    name === "ecommerce" && (
      <>
        <rect x="4.5" y="11.5" width="23" height="16" />
        <path d="M11.5 11.5V8L16 4.5 20.5 8v3.5" />
      </>
    )
  }

  {
    name === "businessTool" && (
      <>
        <rect x="3.5" y="3.5" width="25" height="25" />
        <path d="M3.5 11.5h25M3.5 19.5h25M12.5 3.5v25M20.5 3.5v25" />
      </>
    )
  }

  {
    name === "marketing" && (
      <>
        <path d="M2.5 27.5h27" />
        <path d="M2.5 27.5V2.5" />
        <path d="M5.5 23.5l6-6 5 4 9-11" />
        <path d="M21.5 10.5h5v5" />
      </>
    )
  }

  {
    name === "check" && <path d="M4.5 17.5l7 7 16-16" />
  }
</svg>
